<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= mode === 'create' ? '新增地点' : '编辑地点' %> - 管理员后台</title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/leaflet.css" crossorigin="" />
  <style>
    /* 将编辑界面强制修改为极简黑色表单，去除所有动画与重叠 */
    body {
      background: #000 !important;
      margin: 0; padding: 20px; color: #fff; font-family: sans-serif;
    }
    body::before, body::after, #particles-canvas, .background-glow {
      display: none !important;
    }
    .wrapper {
      max-width: 800px; margin: 0 auto; background: #111; padding: 30px; border-radius: 10px;
    }
    .wrapper h1 { margin-top: 0; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 8px; font-weight: bold; color: #ccc; }
    .form-group input[type="text"], .form-group textarea {
      width: 100%; padding: 10px; background: #222; border: 1px solid #444; color: #fff; border-radius: 6px; box-sizing: border-box;
    }
    .hint { font-size: 12px; color: #888; margin-top: 5px; margin-bottom: 0; }
    
    .preview-box {
      border: 1px solid #444; background: #1a1a1a; padding: 15px; border-radius: 6px; margin-top: 10px;
    }
    .preview-box iframe { width: 100%; height: 350px; border: none; background: #000; display: block; }
    .preview-box img { max-width: 100%; max-height: 400px; display: block; border-radius: 4px; object-fit: contain; }
    .drawings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .drawings-grid img { width: 100%; height: 120px; object-fit: cover; }
    
    button[type="submit"] {
      background: #007bff; color: #fff; padding: 12px 20px; border: none; border-radius: 6px; font-size: 16px; cursor: pointer; width: 100%; margin-top: 20px;
    }
    button[type="submit"]:hover { background: #0056b3; }
    .back-link { display: block; text-align: center; margin-top: 15px; color: #888; text-decoration: none; }
    .back-link:hover { color: #fff; }
    .btn-danger { background: #dc3545; color: #fff; padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; margin-top: 10px; }
  </style>
</head>
<body>
  <div class="wrapper">
    <h1><%= mode === 'create' ? '新增地点' : '编辑地点' %></h1>
    <% if (error) { %><p style="color: #dc3545;"><%= error %></p><% } %>
    <div id="adminNotice" style="display:none; padding:10px; margin-bottom:15px; border-radius:4px;"></div>

    <form method="post" action="<%= mode === 'create' ? '/admin/place/new' : '/admin/place/' + place.id + '/edit' %>" enctype="multipart/form-data">
      <% if (mode === 'create') { %>
      <div class="form-group">
        <label>地点 ID（字母/数字）</label>
        <input type="text" name="id" value="<%= place.id %>" required />
      </div>
      <% } %>

      <div class="form-group">
        <label>名称</label>
        <input type="text" name="name" value="<%= place.name %>" required />
      </div>

      <div class="form-group">
        <label>地图选点 (X / Y)</label>
        <div id="pickerMap" style="width:100%; height:300px; border-radius:6px; margin-bottom:10px; z-index:1;"></div>
        <div style="display:flex; gap:10px;">
          <input type="text" name="px" id="pxInput" value="<%= place.px || place.px === 0 ? place.px : '' %>" placeholder="X" required readonly style="flex:1;" />
          <input type="text" name="py" id="pyInput" value="<%= place.py || place.py === 0 ? place.py : '' %>" placeholder="Y" required readonly style="flex:1;" />
        </div>
      </div>

      <div class="form-group">
        <label>历史时期（可选）</label>
        <input type="text" name="period" value="<%= place.period %>" />
      </div>

      <div class="form-group">
        <label>摘要（可选）</label>
        <textarea name="summary" rows="2"><%= place.summary %></textarea>
      </div>

      <div class="form-group">
        <label>详细介绍（可选）</label>
        <textarea name="content" rows="6"><%= place.content %></textarea>
      </div>

      <div class="form-group">
        <label>主图上传（可选）</label>
        <input type="file" name="imageFile" id="imageFileInput" accept="image/*" style="color:#fff;" />
        <p class="hint">编辑时不选择则保留原图；新增时可不传</p>
        <input type="hidden" name="image" id="imageInput" value="<%= place.image %>" />
        <div class="form-group" style="margin-top:12px; margin-bottom:0;">
          <label>主图说明（可选）</label>
          <input type="text" name="imageCaption" id="imageCaptionInput" value="<%= place.imageCaption || '' %>" placeholder="例如：线稿 / 彩绘 / 作品 1" />
        </div>
        <div class="form-group" style="margin-top:12px; margin-bottom:0;">
          <label>主图署名（可选）</label>
          <input type="text" name="imageCredit" id="imageCreditInput" value="<%= place.imageCredit || '' %>" placeholder="格式：届别 专业 姓名，例如 2023级 建筑学 张三" />
          <p class="hint">建议统一写成「2023级 建筑学 张三」</p>
        </div>
        <div class="preview-box">
          <p class="hint" id="mainImageHint" style="margin-top:0;">主图预览区域</p>
          <img id="mainImagePreview" src="" alt="主图预览" style="display:none;" />
          <button type="button" id="deleteMainImageBtn" class="btn-danger" style="display:none;">删除主图</button>
        </div>
      </div>

      <div class="form-group">
        <label>B站视频链接 (BV/AV号，最多 5 条)</label>
        <textarea name="videoUrls" id="videoUrlsInput" rows="3" placeholder="每行一条，例如：&#10;https://www.bilibili.com/video/BV1xxxxxxx&#10;BV1yyyyyyy"><%= (Array.isArray(place.videoUrls) ? place.videoUrls : []).join('\n') %></textarea>
        <p class="hint" id="videoCountHint">已填 0 / 5 条</p>
        <div class="preview-box">
          <p class="hint" id="videoPreviewHint" style="margin-top:0;">视频预览区域</p>
          <div id="videoPreviewGrid" class="video-grid"></div>
        </div>
      </div>

      <div class="form-group">
        <label>手绘图上传 (可多选)</label>
        <input type="file" name="drawingFiles" id="drawingFilesInput" accept="image/*" multiple style="color:#fff;" />
        <input type="hidden" name="drawingsText" id="drawingsTextInput" value="<%= place.drawingsText || '' %>" />
        <!-- 历史遗留的「按行对应」说明文本框：不显示，仅作为旧版提交格式的兼容载体。
             逐图输入框一旦有内容就会写进上面的 drawingsText，并把这个框清空，
             避免两套数据同时提交时互相覆盖。 -->
        <textarea name="drawingsCaptions" id="drawingsCaptionsInput" style="display:none;"><%= place.drawingsCaptions || '' %></textarea>
        <div class="preview-box">
          <p class="hint" style="margin-top:0;">手绘图预览与逐图说明</p>
          <p class="hint">每张图下面就是它自己的说明和署名框，顺序即详情页画廊顺序。新上传的图会先显示文件名占位，等你填写。</p>
          <div id="drawingsPreviewGrid" class="drawings-grid"></div>
          <p class="hint" id="drawingsEmptyHint" style="margin-top:10px;">还没有手绘图，选择文件后这里会出现每张图的填写框。</p>
        </div>
      </div>

      <div id="drawingInputsContainer"></div>

      <div class="form-group">
        <label>小助手预设问答</label>
        <textarea name="qaRulesText" rows="5" placeholder="问 | 答"><%= place.qaRulesText || '' %></textarea>
      </div>

      <button type="submit"><%= mode === 'create' ? '保存地点' : '保存修改' %></button>
      <a href="/admin" class="back-link">放弃并返回后台</a>
    </form>
  </div>

  <script src="/leaflet.js" crossorigin=""></script>
  <script>
    (function() {
      var pickerEl = document.getElementById("pickerMap");
      var pxInput = document.getElementById("pxInput");
      var pyInput = document.getElementById("pyInput");
      if (!pickerEl || !pxInput || !pyInput) return;

      var imgW = 4096, imgH = 2988;
      var pickerMap = L.map(pickerEl, {
        crs: L.CRS.Simple,
        zoomControl: false,
        attributionControl: false,
        minZoom: -3,
        maxZoom: 1,
        maxBounds: [[0, 0], [imgH, imgW]],
        maxBoundsViscosity: 1.0,
      });

      L.imageOverlay("/images/map_pic.jpg", [[0, 0], [imgH, imgW]]).addTo(pickerMap);
      pickerMap.fitBounds([[0, 0], [imgH, imgW]]);

      var marker = null;
      // 编辑时恢复已有标记
      var initPx = parseInt(pxInput.value) || -1;
      var initPy = parseInt(pyInput.value) || -1;
      if (initPx >= 0 && initPy >= 0) {
        marker = L.marker([initPy, initPx]).addTo(pickerMap);
        pickerMap.setView([initPy, initPx], 0);
      }

      pickerMap.on("click", function(e) {
        var py = Math.round(e.latlng.lat);
        var px = Math.round(e.latlng.lng);
        if (px < 0 || px > imgW || py < 0 || py > imgH) return;
        pxInput.value = px;
        pyInput.value = py;
        if (marker) pickerMap.removeLayer(marker);
        marker = L.marker([py, px]).addTo(pickerMap);
      });
    })();
  </script>

  <script>
    (function () {
      const currentPlaceId = "<%= place.id || '' %>";
      const imageInput = document.getElementById("imageInput");
      const mainImagePreview = document.getElementById("mainImagePreview");
      const mainImageHint = document.getElementById("mainImageHint");
  const imageFileInput = document.getElementById("imageFileInput");
  const drawingFilesInput = document.getElementById("drawingFilesInput");
  const drawingsTextInput = document.getElementById("drawingsTextInput");
  const drawingsCaptionsInput = document.getElementById("drawingsCaptionsInput");
  const drawingsPreviewGrid = document.getElementById("drawingsPreviewGrid");
      const drawingsEmptyHint = document.getElementById("drawingsEmptyHint");
  const drawingInputsContainer = document.getElementById("drawingInputsContainer");
  const deleteMainImageBtn = document.getElementById('deleteMainImageBtn');
  const videoUrlsInput = document.getElementById("videoUrlsInput");
  const videoPreviewGrid = document.getElementById("videoPreviewGrid");
  const videoPreviewHint = document.getElementById("videoPreviewHint");
  const videoCountHint = document.getElementById("videoCountHint");
  const MAX_VIDEO_COUNT = 5;
  const MAX_UPLOAD_MB = 20;
  const MAX_UPLOAD_BYTES = MAX_UPLOAD_MB * 1024 * 1024;

      // "url | 说明 | 署名"；第三列可省略（历史数据只有前两列）
      function normalizeLine(line) {
        const parts = line.split("|");
        const url = (parts[0] || "").trim();
        const caption = (parts[1] || "").trim();
        const credit = parts.length > 2 ? parts.slice(2).join("|").trim() : "";
        return { url, caption, credit };
      }

      function setMainPreview(overrideUrl) {
        const url = (overrideUrl || imageInput.value || "").trim();
        if (!url) {
          mainImagePreview.style.display = "none";
          mainImagePreview.removeAttribute("src");
          mainImageHint.textContent = "请输入主图 URL 以查看预览";
          mainImageHint.style.display = "block";
          deleteMainImageBtn.style.display = 'none';
          return;
        }

        mainImagePreview.style.display = "block";
        mainImagePreview.src = url;
        mainImageHint.style.display = "none";
        // show delete button for any existing image
        deleteMainImageBtn.style.display = 'inline-block';
      }

      // 本次在文件框里选中的图：先把内容读成 dataURL 存下来，
      // 即使之后因为校验失败重新渲染表单，预览和输入框也不会消失。
      let pendingUploads = [];
      // 递增计数值：每次读取新选中的文件后 +1，用来让过期的读取结果自行作废
      let uploadsVersion = 0;
      // 画廊的唯一数据源：渲染、填写、删除都基于它，避免从 DOM 反复重建导致输入丢失
      let drawingItems = [];

      // 把「已有手绘图」和「本次新上传」按最终保存顺序合并：
      // 已有图按下标占位，新图追加在后；删除中间一张后索引会重新写回，不会错位。
      // normalizeLine 会从 "url | 说明 | 署名" 三列里把署名一起解析出来，
      // 漏掉它就会在首次渲染时把已有署名清空。
      function buildDrawingItems() {
        const fromText = (drawingsTextInput.value || "")
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map(normalizeLine)
          .filter((item) => item.url)
          .map((item, index) => ({
            index: String(index),
            url: item.url,
            caption: item.caption || "",
            credit: item.credit || "",
            isUpload: false,
          }));

        const uploads = pendingUploads.map((file) => ({
          index: "u" + file.seq,
          url: file.dataUrl,
          caption: "",
          credit: "",
          isUpload: true,
          name: file.name,
        }));

        return [...fromText, ...uploads].sort((a, b) => {
          if (a.isUpload !== b.isUpload) return a.isUpload ? 1 : -1;
          if (a.isUpload) return Number(a.index.slice(1)) - Number(b.index.slice(1));
          return Number(a.index) - Number(b.index);
        });
      }

      // 已有项保留已填内容，新项用解析出来的原始值补齐
      function syncDrawingItems() {
        const built = buildDrawingItems();
        drawingItems = built.map((item) => {
          const prev = drawingItems.find((p) => p.index === item.index);
          return prev ? { ...item, caption: prev.caption, credit: prev.credit } : item;
        });
        return drawingItems;
      }

      // 逐图输入框：以 index 为键与图片对应，服务端按下标对齐，不存在数错行的问题
      function renderDrawingInputs(items) {
        if (!drawingInputsContainer) return;
        drawingInputsContainer.innerHTML = "";
        if (items.length === 0) return;

        const wrap = document.createElement("div");
        wrap.className = "form-group";
        const title = document.createElement("label");
        title.textContent = "手绘图的说明与署名";
        wrap.appendChild(title);

        const hint = document.createElement("p");
        hint.className = "hint";
        hint.textContent = "与上面的预览一一对应；留空表示这张图暂时不填。署名建议写成「2023级 建筑学 张三」。";
        wrap.appendChild(hint);

        items.forEach((item, index) => {
          const row = document.createElement("div");
          row.style.cssText = "display:flex; gap:8px; margin-top:8px; align-items:center; flex-wrap:wrap;";

          const tag = document.createElement("span");
          tag.textContent = `第 ${index + 1} 张`;
          tag.style.cssText = "color:#9ad; font-size:12px; min-width:60px;";
          row.appendChild(tag);

          const captionInput = document.createElement("input");
          captionInput.type = "text";
          captionInput.name = "drawingCaptions";
          captionInput.className = "drawing-caption-input";
          captionInput.placeholder = "说明（线稿 / 彩绘 / 作品 1）";
          captionInput.value = item.caption || "";
          captionInput.style.cssText = "flex:1 1 200px; min-width:160px;";

          const creditInput = document.createElement("input");
          creditInput.type = "text";
          creditInput.name = "drawingCredits";
          creditInput.className = "drawing-credit-input";
          creditInput.placeholder = "署名（2023级 建筑学 张三）";
          creditInput.value = item.credit || "";
          creditInput.style.cssText = "flex:1 1 220px; min-width:180px;";

          // 打字时写回数据源（不重新渲染，否则输入框会失焦），并同步预览文字
          captionInput.addEventListener("input", () => {
            item.caption = captionInput.value;
            clearLegacyCaptionBox();
            const p = drawingsPreviewGrid.querySelector(`.drawing-caption[data-index="${index}"]`);
            if (p) {
              p.textContent = `第 ${index + 1} 张：${captionInput.value.trim() || item.name || "（未填说明）"}`;
            }
          });
          creditInput.addEventListener("input", () => {
            item.credit = creditInput.value;
            clearLegacyCaptionBox();
          });

          row.appendChild(captionInput);
          row.appendChild(creditInput);
          wrap.appendChild(row);
        });

        drawingInputsContainer.appendChild(wrap);
      }

      // 旧的「按行对应」文本框一旦与新输入框并存，就会互相覆盖，所以用到新框时清掉它
      function clearLegacyCaptionBox() {
        if (drawingsCaptionsInput && drawingsCaptionsInput.value) {
          drawingsCaptionsInput.value = "";
        }
      }

      function renderDrawingsPreview() {
        const allItems = syncDrawingItems();

        drawingsPreviewGrid.innerHTML = "";
        renderDrawingInputs(allItems);

        if (allItems.length === 0) {
          drawingsEmptyHint.style.display = "block";
          return;
        }

        drawingsEmptyHint.style.display = "none";

        allItems.forEach((item, index) => {
          const shownCaption = (item.caption || "").trim() || (item.isUpload ? item.name : "（未填说明）");

          const card = document.createElement("div");
          card.style.background = "#222";
          card.style.padding = "5px";
          card.style.borderRadius = "4px";

          const img = document.createElement("img");
          img.src = item.url;
          img.alt = shownCaption;

          const caption = document.createElement("p");
          caption.className = "drawing-caption";
          caption.dataset.index = String(index);
          caption.style.fontSize = "12px";
          caption.style.color = "#ccc";
          caption.style.margin = "5px 0";
          caption.textContent = `第 ${index + 1} 张：${shownCaption}`;

          card.appendChild(img);
          card.appendChild(caption);

          // If this item is an existing drawing (not newly uploaded preview), render a delete button
          if (!item.isUpload && item.url) {
            const del = document.createElement('button');
            del.type = 'button';
            del.textContent = '删除';
            del.className = 'btn-danger';
            del.style.width = '100%';
            del.addEventListener('click', async () => {
              if (!confirm('确认删除该手绘图？此操作会从服务器删除文件且不可恢复。')) return;
              try {
                const res = await fetch(`/admin/place/${encodeURIComponent(currentPlaceId)}/image/delete`, {
                  method: 'POST',
                  headers: {'Content-Type': 'application/json'},
                  body: JSON.stringify({ type: 'drawing', url: item.url })
                });
                const data = await res.json();
                if (data && data.success) {
                  // 服务端已删除该条记录：用返回的列表重建隐藏字段与数据源。
                  // 逐图输入框带 name 会随表单提交，所以必须一起重建，
                  // 否则会把刚删掉那张的说明又提交回去。
                  const remaining = (data.place && Array.isArray(data.place.drawings)) ? data.place.drawings : [];
                  drawingsTextInput.value = remaining.map((d) => `${d.url} | ${d.caption || ''} | ${d.credit || ''}`).join('\n');
                  if (drawingsCaptionsInput) {
                    drawingsCaptionsInput.value = "";
                  }
                  drawingItems = remaining.map((d, i) => ({
                    index: String(i),
                    url: d.url,
                    caption: d.caption || "",
                    credit: d.credit || "",
                    isUpload: false,
                  }));
                  renderDrawingsPreview();
                  showNotice('手绘图已删除', 'success');
                } else {
                  showNotice((data && data.error) || '删除失败', 'error');
                }
              } catch (err) {
                console.error(err);
                showNotice('删除请求出错', 'error');
              }
            });
            card.appendChild(del);
          }

          drawingsPreviewGrid.appendChild(card);
        });
      }

      function buildBilibiliEmbed(rawUrl) {
        const url = (rawUrl || "").trim();
        if (!url) {
          return "";
        }
        if (url.includes("player.bilibili.com")) {
          return url;
        }
        const bvidMatch = url.match(/BV[0-9A-Za-z]+/);
        if (bvidMatch) {
          return `https://player.bilibili.com/player.html?bvid=${bvidMatch[0]}&high_quality=1&autoplay=0`;
        }
        const aidMatch = url.match(/av(\d+)/i);
        if (aidMatch) {
          return `https://player.bilibili.com/player.html?aid=${aidMatch[1]}&high_quality=1&autoplay=0`;
        }
        return "";
      }

      function renderVideoPreviews() {
        const urls = (videoUrlsInput?.value || "")
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean);

        videoCountHint.textContent = `已填 ${urls.length} / ${MAX_VIDEO_COUNT} 条`;
        videoCountHint.style.color = urls.length > MAX_VIDEO_COUNT ? "#ff9c9c" : "";

        videoPreviewGrid.innerHTML = "";

        const embeds = urls.slice(0, MAX_VIDEO_COUNT).map(buildBilibiliEmbed).filter(Boolean);

        if (embeds.length === 0) {
          videoPreviewHint.textContent = "请输入 B 站视频链接以查看预览";
          videoPreviewHint.style.display = "block";
          return;
        }

        videoPreviewHint.style.display = "none";

        embeds.forEach((embedUrl) => {
          const box = document.createElement("div");
          box.className = "video-embed";
          const iframe = document.createElement("iframe");
          iframe.src = embedUrl;
          iframe.loading = "lazy";
          iframe.allowFullscreen = true;
          iframe.setAttribute("allow", "autoplay; fullscreen; picture-in-picture; encrypted-media");
          box.appendChild(iframe);
          videoPreviewGrid.appendChild(box);
        });
      }

      mainImagePreview.addEventListener("error", () => {
        mainImagePreview.style.display = "none";
        mainImageHint.textContent = "主图加载失败，请检查 URL 是否正确";
        mainImageHint.style.display = "block";
      });

      imageInput.addEventListener("input", () => setMainPreview());
      if (imageFileInput) {
        imageFileInput.addEventListener("change", () => {
          const file = imageFileInput.files && imageFileInput.files[0];
          if (file && file.size > MAX_UPLOAD_BYTES) {
            imageFileInput.value = '';
            showNotice(`主图超过 ${MAX_UPLOAD_MB}MB，请压缩后再上传。`, 'error');
            setMainPreview();
            return;
          }
          if (file) {
            const previewUrl = URL.createObjectURL(file);
            setMainPreview(previewUrl);
            return;
          }
          setMainPreview();
        });
      }
      // delete main image handler
      if (deleteMainImageBtn) {
        deleteMainImageBtn.addEventListener('click', async () => {
          if (!confirm('确认删除主图？此操作会从服务器删除文件且不可恢复。')) return;
          const url = (imageInput.value || '').trim();
          try {
            const res = await fetch(`/admin/place/${encodeURIComponent(currentPlaceId)}/image/delete`, {
              method: 'POST',
              headers: {'Content-Type': 'application/json'},
              body: JSON.stringify({ type: 'main', url })
            });
            const data = await res.json();
            if (data && data.success) {
              // clear hidden input and preview
              imageInput.value = '';
              setMainPreview();
              showNotice('主图已删除，您可以重新上传', 'success');
            } else {
              showNotice((data && data.error) || '删除失败', 'error');
            }
          } catch (err) {
            console.error(err);
            showNotice('删除请求出错', 'error');
          }
        });
      }

      function showNotice(message, type) {
        const el = document.getElementById('adminNotice');
        if (!el) return;
        el.textContent = message || '';
        el.style.display = message ? 'block' : 'none';
        el.style.background = type === 'success' ? 'rgba(20, 120, 80, 0.12)' : 'rgba(180, 40, 40, 0.12)';
        el.style.border = type === 'success' ? '1px solid rgba(20, 120, 80, 0.35)' : '1px solid rgba(180, 40, 40, 0.35)';
        el.style.color = type === 'success' ? '#0f6a4a' : '#9d1c1c';
        el.style.padding = '8px 10px';
        el.style.borderRadius = '8px';
      }
      if (drawingFilesInput) {
        drawingFilesInput.addEventListener("change", () => {
          const files = drawingFilesInput.files ? Array.from(drawingFilesInput.files) : [];
          const tooLarge = files.find((file) => file.size > MAX_UPLOAD_BYTES);
          if (tooLarge) {
            drawingFilesInput.value = '';
            showNotice(`手绘图单张超过 ${MAX_UPLOAD_MB}MB，请压缩后再上传。`, 'error');
            renderDrawingsPreview();
            return;
          }
          // 把选中的图读成 dataURL 存进 pendingUploads：这样即使提交后因为校验错误
          // 重新渲染了整个表单，预览和填写框也不会丢。
          const currentVersion = ++uploadsVersion;
          pendingUploads = [];
          if (files.length === 0) {
            renderDrawingsPreview();
            return;
          }
          let done = 0;
          files.forEach((file, i) => {
            const reader = new FileReader();
            reader.addEventListener("load", () => {
              done += 1;
              // 期间用户又改了选择，这次读取结果作废
              if (currentVersion !== uploadsVersion) return;
              pendingUploads.push({ seq: i, name: file.name, dataUrl: String(reader.result || "") });
              if (done === files.length) {
                pendingUploads.sort((a, b) => a.seq - b.seq);
                renderDrawingsPreview();
              }
            });
            reader.addEventListener("error", () => {
              done += 1;
              if (done === files.length) renderDrawingsPreview();
            });
            reader.readAsDataURL(file);
          });
        });
      }
      drawingsTextInput.addEventListener("input", renderDrawingsPreview);
      if (drawingsCaptionsInput) {
        drawingsCaptionsInput.addEventListener("input", renderDrawingsPreview);
      }
      if (videoUrlsInput) {
        videoUrlsInput.addEventListener("input", renderVideoPreviews);
      }

  setMainPreview();
  renderDrawingsPreview();
      renderVideoPreviews();
    })();
  </script>

