<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>登录 - 东北大学百年育人兴邦史数智地图</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="auth-body">
  <div class="background-glow" style="top:10%;left:10%"></div>
  <div class="background-glow" style="top:60%;left:70%;background:radial-gradient(circle,rgba(157,78,221,0.22),transparent 60%);animation-delay:2s"></div>
  <main class="auth-card">
    <img src="/images/neusign.jpg" alt="东北大学校徽" class="login-emblem" />
    <h1 class="auth-title">东北大学百年育人兴邦史<br />数智地图</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <div class="auth-choice">
      <a href="/login/account" class="circle-btn" aria-label="登录">
        <span class="circle-icon">🔑</span>
        <span class="circle-label">登录</span>
      </a>
      <form method="post" action="/login/guest" class="circle-form">
        <button type="submit" class="circle-btn circle-btn-guest" aria-label="访客">
          <span class="circle-icon">👀</span>
          <span class="circle-label">访客</span>
        </button>
      </form>
    </div>
  </main>
</body>
</html>
