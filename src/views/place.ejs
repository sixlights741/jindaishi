<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= place.name %> - 东北大学百年育人兴邦史数智地图</title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/pet/pet.css?v=20261019" />
</head>
<body>
  <header class="topbar">
    <div class="brand-block">
      <img src="/images/neusign-new.png" alt="东北大学校徽" class="brand-emblem" />
      <div>
      <h1><%= place.name %></h1>
      <p>校史地点详情</p>
      </div>
    </div>
    <div class="actions">
      <a href="/" class="btn ghost">返回地图</a>
      <form method="post" action="/logout">
        <button type="submit" class="btn">退出登录</button>
      </form>
    </div>
  </header>

  <main class="detail-container">
    <article class="detail-card">
      <% if (place.image) { %>
        <img
          src="<%= place.image %>"
          alt="<%= place.name %>"
          class="detail-image"
          data-caption="<%= place.imageCaption || '' %>"
          data-credit="<%= place.imageCredit || '' %>"
        />
        <% if (place.imageCredit) { %>
          <p class="detail-image-credit"><%= place.imageCredit %></p>
        <% } %>
      <% } %>
      <p class="tag"><%= place.period %></p>
      <p class="lead"><%= place.summary %></p>
      <div class="content"><%= place.content %></div>

      <%
        const MAX_VIDEOS = 5;
        const rawVideoUrls = (Array.isArray(place.videoUrls) ? place.videoUrls : []).slice(0, MAX_VIDEOS);
        const videoEmbeds = rawVideoUrls
          .map((rawUrl) => {
            const url = String(rawUrl || "").trim();
            if (!url) {
              return "";
            }
            if (url.includes("player.bilibili.com")) {
              return url;
            }
            const bvidMatch = url.match(/BV[0-9A-Za-z]+/);
            const aidMatch = url.match(/av(\d+)/i);
            if (bvidMatch) {
              return `https://player.bilibili.com/player.html?bvid=${bvidMatch[0]}&high_quality=1&autoplay=0`;
            }
            if (aidMatch) {
              return `https://player.bilibili.com/player.html?aid=${aidMatch[1]}&high_quality=1&autoplay=0`;
            }
            return "";
          })
          .filter(Boolean);
      %>

      <% if (videoEmbeds.length > 0) { %>
        <section class="video-section">
          <h3 class="gallery-title">地点视频</h3>
          <div class="video-grid">
            <% videoEmbeds.forEach((embedUrl) => { %>
              <div class="video-embed">
                <iframe
                  src="<%= embedUrl %>"
                  loading="lazy"
                  allowfullscreen
                  webkitallowfullscreen
                  mozallowfullscreen
                  allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                ></iframe>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (Array.isArray(place.drawings) && place.drawings.length > 0) { %>
        <h3 class="gallery-title">小组手绘图展示</h3>
        <section class="drawing-grid">
          <% place.drawings.forEach((drawing) => { %>
            <article class="drawing-item">
              <img src="<%= drawing.url %>" alt="<%= drawing.note || (place.name + '手绘图') %>" data-note="<%= drawing.note || '' %>" />
              <% if (drawing.note) { %>
                <p class="drawing-note"><%= drawing.note %></p>
              <% } %>
            </article>
          <% }) %>
        </section>
      <% } %>
    </article>
  </main>

  <!-- 桌宠：点击它就能问这个地点的历史（渲染见 partials/pet.ejs） -->
  <%- include('partials/pet', { place, user }) %>

  <footer class="site-footer">
    <p>&copy; 2026 东北大学 &middot; <a href="/">返回首页</a></p>
    <p>辽ICP备2026009544号-1</p>
    <p>联系QQ：228343975</p>
  </footer>

  <!-- 图片灯箱 -->
  <div class="image-lightbox" id="imageLightbox">
    <button class="image-lightbox-close" id="imageLightboxClose" type="button">&times;</button>
    <div class="image-lightbox-content">
      <img class="image-lightbox-img" id="imageLightboxImg" src="" alt="" />
      <p class="image-lightbox-caption" id="imageLightboxCaption"></p>
      <p class="image-lightbox-credit" id="imageLightboxCredit"></p>
    </div>
  </div>

  <!-- 图片灯箱交互 -->
  <script>
    (function () {
      var lightbox = document.getElementById("imageLightbox");
      var lightboxImg = document.getElementById("imageLightboxImg");
      var lightboxCaption = document.getElementById("imageLightboxCaption");
      var lightboxCredit = document.getElementById("imageLightboxCredit");
      var closeBtn = document.getElementById("imageLightboxClose");

      // credit 是「届别 专业 姓名」的署名，单独一行显示；没有就隐藏这一行
      function openLightbox(src, caption, credit) {
        lightboxImg.src = src;
        lightboxImg.alt = caption || "";
        lightboxCaption.textContent = caption || "";
        lightboxCaption.style.display = caption ? "" : "none";
        if (lightboxCredit) {
          lightboxCredit.textContent = credit || "";
          lightboxCredit.style.display = credit ? "" : "none";
        }
        lightbox.classList.add("open");
        document.body.style.overflow = "hidden";
      }

      function closeLightbox() {
        lightbox.classList.remove("open");
        document.body.style.overflow = "";
        setTimeout(function () {
          if (!lightbox.classList.contains("open")) {
            lightboxImg.src = "";
          }
        }, 350);
      }

      // 主图：说明与署名从 data-* 上读
      var detailImage = document.querySelector(".detail-image");
      if (detailImage) {
        detailImage.addEventListener("click", function () {
          openLightbox(
            detailImage.src,
            detailImage.getAttribute("data-caption") || detailImage.alt,
            detailImage.getAttribute("data-credit") || ""
          );
        });
      }

      // 手绘图：每张图只有一段自由文字，放在 data-note 上
      var drawingItems = document.querySelectorAll(".drawing-item img");
      drawingItems.forEach(function (img) {
        img.addEventListener("click", function (e) {
          e.stopPropagation();
          var note = img.getAttribute("data-note") || "";
          openLightbox(img.src, note || img.alt, "");
        });
      });

      // 关闭按钮
      closeBtn.addEventListener("click", closeLightbox);

      // 点击遮罩关闭
      lightbox.addEventListener("click", function (e) {
        if (e.target === lightbox) {
          closeLightbox();
        }
      });

      // ESC 关闭
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && lightbox.classList.contains("open")) {
          closeLightbox();
        }
      });
    })();
  </script>

  <!-- 累计访问角标：访客与普通用户同样可见（visitCount 是全局 res.locals） -->
  <div class="visit-badge">
    <span class="visit-icon">👁</span>
    <span>累计访问</span>
    <span class="visit-count"><%= typeof visitCount !== 'undefined' ? visitCount : 0 %></span>
  </div>
  <script>
    // 角标固定在右下角，页面滚到底时会压住页脚的备案号/联系方式（任何屏幕宽度都会）。
    // 页脚进入视口时按实际重叠量把角标顶上去，离开后再放回底部。
    (function () {
      var badge = document.querySelector(".visit-badge");
      var footer = document.querySelector(".site-footer");
      if (!badge || !footer) return;

      var BASE_BOTTOM = window.innerWidth <= 520 ? 14 : 24;
      var raf = null;

      function apply() {
        raf = null;
        // 先归位再测量：角标自身位置会影响它与页脚的重叠量
        badge.style.bottom = BASE_BOTTOM + "px";
        var overlap = badge.getBoundingClientRect().bottom - footer.getBoundingClientRect().top;
        if (overlap > 0) {
          badge.style.bottom = BASE_BOTTOM + overlap + 10 + "px";
        }
      }

      function schedule() {
        if (raf !== null) return;
        raf = window.requestAnimationFrame(apply);
      }

      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule);
      apply();
    })();
  </script>
</body>
</html>
